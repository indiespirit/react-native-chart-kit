---
import LegalLayout from "../layouts/LegalLayout.astro";
---

<LegalLayout
  title="Contact Chart Kit"
  canonicalPath="/contact"
  description="Contact Berman Digital Ltd for Chart Kit support, sales, and license questions."
  updated="September 6, 2026"
>
  <section>
    <h2>Technical support</h2>
    <p>
      Email <a href="mailto:support@chartkit.io">support@chartkit.io</a> for Chart
      Kit support. For a public library bug, use the <a
        href="https://github.com/chart-kit/react-native-chart-kit/issues"
        >GitHub issue tracker</a
      >. Include the package version, React Native version, platform, chart
      type, and a small data sample. Describe the expected result and the actual
      result. Remove passwords, license details, and private customer data from
      public reports.
    </p>
    <p>
      The <a href="/docs/react-native/troubleshooting">troubleshooting guide</a> covers
      common installation, rendering, and gesture problems. The <a
        href="/developers">developer guide</a
      > links to examples, Markdown documentation, and the public documentation API.
    </p>
  </section>
  <section>
    <h2>Sales and licensing</h2>
    <p>
      Email <a href="mailto:sales@chartkit.io">sales@chartkit.io</a> for Pro plans,
      license scope, and Enterprise purchasing questions. Include your team size and
      the number of production apps so we can identify the relevant plan. Berman Digital
      Ltd is based in Ontario, Canada. See the <a href="/about">About page</a>, <a
        href="/terms">terms</a
      >, and <a href="/privacy">privacy policy</a> for company and product information.
    </p>
  </section>
</LegalLayout>
